# --- Aplicación ---
APP_NAME=Digital Platform
ENVIRONMENT=development            # development | production

# --- Base de datos de la plataforma (PostgreSQL) ---
# Opción A: variables sueltas (la contraseña puede tener @ : / # sin escapar)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_platform_template
DB_USER=postgres
DB_PASSWORD=
# Opción B: una sola URL (si la definís, tiene prioridad sobre las DB_*)
# DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/digital_platform_template

# --- Seguridad ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CAMBIAR_POR_UN_VALOR_ALEATORIO_DE_AL_MENOS_32_CARACTERES
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false                # en producción (HTTPS) debe ser true

# Solo si el frontend llama directo al backend desde otro origen (separados por coma).
# Con el proxy de Next.js (por defecto) no hace falta: dejar vacío.
CORS_ORIGINS=

# --- Login: límite de intentos fallidos ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# --- API Builder ---
# Cifra las contraseñas de las conexiones guardadas. Mínimo 32 caracteres. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Distinta de JWT_SECRET. Si la cambiás, hay que volver a ingresar la contraseña de cada proyecto.
ENCRYPTION_KEY=
# Servidores a los que el Builder puede conectarse (vacío = cualquiera). Acepta IP, rangos CIDR,
# nombres y comodines, separados por coma. Ejemplo: 192.168.50.0/24,db.interno,*.miempresa.com
BUILDER_ALLOWED_HOSTS=
BUILDER_CONNECT_TIMEOUT=5
BUILDER_QUERY_TIMEOUT_SECONDS=15
